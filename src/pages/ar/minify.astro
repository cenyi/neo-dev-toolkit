---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import arTranslations from '../../i18n/locales/ar.js';

const lang = 'ar-SA';
const t = arTranslations;
---

<BaseLayout title="مصغر JSON عبر الإنترنت" lang={lang} description="مصغر JSON مجاني عبر الإنترنت" keywords="مصغر JSON">
  <div slot="header"><LanguageSwitcher currentLocale="ar" /></div>
  <Sidebar slot="sidebar" t={t} />
  <div class="json-formatter-container">
    <div class="editor-workspace">
      <div class="input-area">
        <div class="input-section">
          <h1 class="section-label">JSON Minifier</h1>
          <div class="input-editor-wrapper"><div id="monaco-editor-container" class="monaco-editor-container"></div></div>
        </div>
        <div class="output-controls"><button id="minify-btn">تصغير</button></div>
      </div>
    </div>
  </div>
  <script type="module">import * as monaco from 'https://esm.sh/monaco-editor@0.45.0';let editor=null;document.addEventListener('DOMContentLoaded',()=>{const c=document.getElementById('monaco-editor-container');if(c)editor=monaco.editor.create(c,{value:'',language:'json',theme:'vs',automaticLayout:true,fontSize:13});});document.getElementById('minify-btn')?.addEventListener('click',()=>{if(editor){editor.setValue(JSON.stringify(JSON.parse(editor.getValue())));}});</script>
  <style>.json-formatter-container{max-width:1800px;margin:0 auto;padding:8px;height:calc(100vh - var(--sidebar-height,40px))}.input-section{flex:1;display:flex;flex-direction:column}h1.section-label{font-size:1rem;font-weight:700;margin-bottom:8px}.input-editor-wrapper{display:flex;border:1px solid #e1e4e8;border-radius:8px;overflow:hidden;flex:1}.monaco-editor-container{flex:1;min-height:300px}.output-controls{display:flex;gap:6px;margin-top:10px}.output-controls button{padding:8px 16px;background:#3b82f6;color:white;border:none;border-radius:5px}</style>
</BaseLayout>
