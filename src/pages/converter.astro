---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import enTranslations from '../i18n/locales/en.js';

const lang = 'en-US';
const t = enTranslations;
---

<BaseLayout
  title="JSON Converter Online - Convert JSON to CSV, XML, YAML, TypeScript"
  lang={lang}
  description="Free online JSON converter. Convert JSON to CSV, Excel, XML, YAML, TypeScript, and more. Also supports converting CSV, XML, YAML to JSON."
  keywords="JSON converter, JSON to CSV, JSON to XML, JSON to YAML, JSON to TypeScript, convert JSON, JSON conversion tool"
>
  <div slot="header">
    <LanguageSwitcher currentLocale="en" />
  </div>
  <Sidebar slot="sidebar" t={t} />

  <div class="converter-container">

    <div class="converter-workspace">
      <div class="input-panel">
        <div class="panel-header">
          <h2>Input JSON</h2>
          <div class="format-selector">
            <label>Input Format:</label>
            <select id="input-format">
              <option value="json">JSON</option>
              <option value="xml">XML</option>
              <option value="yaml">YAML</option>
              <option value="csv">CSV</option>
            </select>
          </div>
        </div>
        <div class="editor-wrapper">
          <div id="input-editor" class="editor-container"></div>
        </div>
      </div>

      <div class="output-panel">
        <div class="panel-header">
          <h2>Output</h2>
          <div class="format-selector">
            <label>Output Format:</label>
            <select id="output-format">
              <option value="json">JSON</option>
              <option value="csv">CSV</option>
              <option value="xml">XML</option>
              <option value="yaml">YAML</option>
              <option value="typescript">TypeScript</option>
              <option value="go">Go</option>
              <option value="rust">Rust</option>
              <option value="python">Python</option>
            </select>
          </div>
        </div>
        <div class="editor-wrapper">
          <div id="output-editor" class="editor-container"></div>
        </div>
        <div class="output-actions">
          <button id="convert-btn">Convert</button>
          <button id="copy-btn">Copy Result</button>
        </div>
      </div>
    </div>

  </div>

  <script type="module">
    window.MonacoEnvironment = {
      getWorkerUrl: function (workerId, label) {
        return `https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs/base/workers/${label === 'json' ? 'json.worker' : 'editor.worker'}.js`;
      }
    };

    import * as monaco from 'https://esm.sh/monaco-editor@0.45.0';

    let inputEditor = null;
    let outputEditor = null;

    document.addEventListener('DOMContentLoaded', () => {
      initializeEditors();
      setupEventListeners();
    });

    function initializeEditors() {
      const inputContainer = document.getElementById('input-editor');
      const outputContainer = document.getElementById('output-editor');

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          if (inputContainer && inputContainer.offsetWidth > 0) {
            createEditors(inputContainer, outputContainer);
          } else {
            setTimeout(() => createEditors(inputContainer, outputContainer), 50);
          }
        });
      });
    }

    function createEditors(inputContainer, outputContainer) {
      inputEditor = monaco.editor.create(inputContainer, {
        value: '{"name": "John", "age": 30}',
        language: 'json',
        theme: 'vs',
        automaticLayout: true,
        fontSize: 13,
        fontFamily: "'Monaco', 'Menlo', 'Ubuntu Mono', monospace",
        minimap: { enabled: false },
        lineNumbers: 'on',
        tabSize: 2,
        padding: { top: 12, bottom: 12 }
      });

      outputEditor = monaco.editor.create(outputContainer, {
        value: '',
        language: 'json',
        theme: 'vs',
        automaticLayout: true,
        fontSize: 13,
        fontFamily: "'Monaco', 'Menlo', 'Ubuntu Mono', monospace",
        minimap: { enabled: false },
        lineNumbers: 'on',
        tabSize: 2,
        padding: { top: 12, bottom: 12 },
        readOnly: true
      });
    }

    function convert() {
      if (!inputEditor || !outputEditor) return;

      const inputFormat = document.getElementById('input-format').value;
      const outputFormat = document.getElementById('output-format').value;
      const input = inputEditor.getValue();

      try {
        let data;
        
        // Parse input
        if (inputFormat === 'json') {
          data = JSON.parse(input);
        } else if (inputFormat === 'xml') {
          data = parseXmlToJson(input);
        } else if (inputFormat === 'yaml') {
          data = parseYaml(input);
        } else if (inputFormat === 'csv') {
          data = parseCsv(input);
        }

        // Convert output
        let output;
        if (outputFormat === 'json') {
          output = JSON.stringify(data, null, 2);
        } else if (outputFormat === 'csv') {
          output = jsonToCsv(data);
        } else if (outputFormat === 'xml') {
          output = jsonToXml(data);
        } else if (outputFormat === 'yaml') {
          output = jsonToYaml(data);
        } else if (outputFormat === 'typescript') {
          output = jsonToTypeScript(data);
        } else if (outputFormat === 'go') {
          output = jsonToGo(data);
        } else if (outputFormat === 'rust') {
          output = jsonToRust(data);
        } else if (outputFormat === 'python') {
          output = jsonToPython(data);
        }

        outputEditor.setValue(output);
        outputEditor.setLanguage(outputFormat === 'typescript' ? 'typescript' : outputFormat);
        showToast('Converted successfully!');
      } catch (e) {
        showToast('Error: ' + e.message);
      }
    }

    function parseXmlToJson(xml) {
      const parser = new DOMParser();
      const doc = parser.parseFromString(xml, 'text/xml');
      const convert = (node) => {
        if (node.nodeType === Node.TEXT_NODE) return node.textContent.trim();
        if (node.nodeType !== Node.ELEMENT_NODE) return null;
        const obj = {};
        if (node.attributes) {
          for (let i = 0; i < node.attributes.length; i++) {
            obj['@' + node.attributes[i].name] = node.attributes[i].value;
          }
        }
        for (let i = 0; i < node.childNodes.length; i++) {
          const child = node.childNodes[i];
          const result = convert(child);
          if (result) {
            if (child.nodeType === Node.TEXT_NODE) {
              obj['#text'] = result;
            } else {
              obj[child.nodeName] = result;
            }
          }
        }
        return obj;
      };
      return convert(doc.documentElement);
    }

    function parseYaml(yaml) {
      const lines = yaml.split('\n');
      const result = {};
      lines.forEach(line => {
        const match = line.match(/^(\s*)([^:]+):\s*(.*)$/);
        if (match) {
          const [, indent, key, value] = match;
          result[key.trim()] = value.trim();
        }
      });
      return result;
    }

    function parseCsv(csv) {
      const lines = csv.trim().split('\n');
      const headers = lines[0].split(',').map(h => h.trim());
      const data = lines.slice(1).map(line => {
        const values = line.split(',');
        const obj = {};
        headers.forEach((h, i) => {
          obj[h] = values[i]?.trim();
        });
        return obj;
      });
      return data;
    }

    function jsonToCsv(data) {
      if (!Array.isArray(data)) data = [data];
      const headers = Object.keys(data[0] || {});
      const rows = [headers.join(',')];
      data.forEach(item => {
        rows.push(headers.map(h => item[h]).join(','));
      });
      return rows.join('\n');
    }

    function jsonToXml(data, root = 'root') {
      const convert = (obj, tag) => {
        if (typeof obj !== 'object' || obj === null) {
          return `<${tag}>${obj}</${tag}>`;
        }
        let xml = `<${tag}>`;
        for (const [key, value] of Object.entries(obj)) {
          xml += convert(value, key);
        }
        xml += `</${tag}>`;
        return xml;
      };
      return `<?xml version="1.0" encoding="UTF-8"?>\n${convert(data, root)}`;
    }

    function jsonToYaml(data, indent = 0) {
      const spaces = '  '.repeat(indent);
      if (typeof data !== 'object' || data === null) {
        return `${spaces}${data}`;
      }
      if (Array.isArray(data)) {
        return data.map(item => `${spaces}- ${jsonToYaml(item, indent + 1)}`).join('\n');
      }
      return Object.entries(data).map(([key, value]) => {
        if (typeof value === 'object' && value !== null) {
          return `${spaces}${key}:\n${jsonToYaml(value, indent + 1)}`;
        }
        return `${spaces}${key}: ${value}`;
      }).join('\n');
    }

    function jsonToTypeScript(data, name = 'Root') {
      const convert = (obj, typeName) => {
        if (obj === null) return 'any';
        if (typeof obj === 'string') return 'string';
        if (typeof obj === 'number') return 'number';
        if (typeof obj === 'boolean') return 'boolean';
        if (Array.isArray(obj)) {
          if (obj.length === 0) return 'any[]';
          return `${convert(obj[0], typeName + 'Item')}[]`;
        }
        const props = Object.entries(obj).map(([key, value]) => {
          return `  ${key}: ${convert(value, typeName + key.charAt(0).toUpperCase() + key.slice(1))};`;
        });
        return `interface ${typeName} {\n${props.join('\n')}\n}`;
      };
      return convert(data, name);
    }

    function jsonToGo(data, name = 'Root') {
      const convert = (obj, typeName) => {
        if (obj === null) return 'interface{}';
        if (typeof obj === 'string') return 'string';
        if (typeof obj === 'number') return Number.isInteger(obj) ? 'int' : 'float64';
        if (typeof obj === 'boolean') return 'bool';
        if (Array.isArray(obj)) return '[]interface{}';
        let code = `type ${typeName} struct {\n`;
        for (const [key, value] of Object.entries(obj)) {
          const fieldName = key.charAt(0).toUpperCase() + key.slice(1);
          code += `  ${fieldName} ${convert(value, typeName + fieldName)} \`json:"${key}"\`\n`;
        }
        return code + '}';
      };
      return convert(data, name);
    }

    function jsonToRust(data, name = 'Root') {
      const convert = (obj, typeName) => {
        if (obj === null) return 'serde_json::Value';
        if (typeof obj === 'string') return 'String';
        if (typeof obj === 'number') return 'f64';
        if (typeof obj === 'boolean') return 'bool';
        if (Array.isArray(obj)) return 'Vec<Value>';
        let code = `#[derive(Serialize, Deserialize)]\nstruct ${typeName} {\n`;
        for (const [key, value] of Object.entries(obj)) {
          code += `  ${key}: ${convert(value, typeName + key.charAt(0).toUpperCase() + key.slice(1))},\n`;
        }
        return code + '}';
      };
      return convert(data, name);
    }

    function jsonToPython(data, name = 'Root') {
      const convert = (obj, typeName) => {
        if (obj === null) return 'Any';
        if (typeof obj === 'string') return 'str';
        if (typeof obj === 'number') return 'float';
        if (typeof obj === 'boolean') return 'bool';
        if (Array.isArray(obj)) return 'List[Any]';
        let code = `from dataclasses import dataclass\nfrom typing import Optional, List, Any\n\n`;
        const props = Object.entries(obj).map(([key, value]) => {
          const pyType = convert(value, typeName + key.charAt(0).toUpperCase() + key.slice(1));
          return `    ${key}: ${pyType}`;
        });
        return code + `@dataclass\nclass ${typeName}:\n${props.join('\n')}`;
      };
      return convert(data, name);
    }

    function setupEventListeners() {
      document.getElementById('convert-btn').addEventListener('click', convert);
      document.getElementById('copy-btn').addEventListener('click', async () => {
        if (!outputEditor) return;
        await navigator.clipboard.writeText(outputEditor.getValue());
        showToast('Copied!');
      });
      document.getElementById('input-format').addEventListener('change', (e) => {
        if (inputEditor) inputEditor.setLanguage(e.target.value);
      });
    }

    function showToast(msg) {
      const existing = document.querySelector('.toast-message');
      if (existing) existing.remove();
      const toast = document.createElement('div');
      toast.className = 'toast-message';
      toast.textContent = msg;
      toast.style.cssText = 'position:fixed;bottom:20px;right:20px;background:#22c55e;color:white;padding:12px 20px;border-radius:6px;z-index:9999';
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 3000);
    }
  </script>

  <style>
    .converter-container { max-width: 1800px; margin: 0 auto; padding: 8px; height: calc(100vh - var(--sidebar-height, 40px)); }
    .converter-workspace { display: flex; gap: 10px; flex: 1; min-height: 0; }
    .input-panel, .output-panel { flex: 1; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
    
    .panel-header { display: flex; justify-content: space-between; align-items: center; padding: 8px 12px; background: #f8f9fa; border-radius: 6px 6px 0 0; border: 1px solid #e9ecef; border-bottom: none; }
    .panel-header h2 { font-size: 0.9rem; font-weight: 600; color: #1f2937; margin: 0; }
    .format-selector { display: flex; gap: 8px; align-items: center; }
    .format-selector label { font-size: 0.8rem; color: #64748b; }
    .format-selector select { padding: 4px 8px; border: 1px solid #e5e7eb; border-radius: 4px; font-size: 12px; }
    
    .editor-wrapper { flex: 1; display: flex; border: 1px solid #e1e4e8; border-radius: 0 0 8px 8px; overflow: hidden; min-height: 0; }
    .editor-container { flex: 1; width: 100%; min-height: 300px; }
    
    .output-actions { display: flex; gap: 8px; }
    .output-actions button { padding: 8px 16px; background: #3b82f6; color: white; border: none; border-radius: 5px; cursor: pointer; }
    .output-actions button:hover { background: #2563eb; }

    @media (max-width: 768px) {
      .converter-workspace { flex-direction: column; }
    }

    .content-section {
      max-width: 900px;
      margin: 40px auto;
      padding: 0 20px;
    }
    .content-section h2 { font-size: 1.75rem; color: #0f172a; margin: 30px 0 15px; }
    .content-section h3 { font-size: 1.25rem; color: #1f2937; margin: 25px 0 12px; }
    .content-section p { color: #4b5563; line-height: 1.7; margin-bottom: 15px; }
    .content-section ul, .content-section ol { color: #4b5563; line-height: 1.8; margin: 10px 0 15px 25px; }
    .content-section li { margin-bottom: 6px; }
    .content-section a { color: #2563eb; text-decoration: none; }
    .content-section a:hover { text-decoration: underline; }
    .content-section code { background: #f1f5f9; padding: 2px 6px; border-radius: 4px; font-size: 0.9em; }
  </style>

  <!-- Content Section -->
  <div class="content-section">
    <h2>JSON Converter Online - Transform JSON to Any Format</h2>
    <p>Welcome to our comprehensive JSON Converter tool, the all-in-one solution for converting JSON to and from various data formats. Whether you need to convert JSON to CSV for Excel, XML for legacy systems, YAML for configuration files, or generate TypeScript interfaces for type safety, our tool handles it all seamlessly.</p>

    <p>Data format conversion is a common challenge in software development. Different systems and programming languages require different data formats. Our JSON Converter bridges these gaps, allowing you to transform data between formats instantly without writing any code.</p>

    <h3>Supported Conversions</h3>
    <p>Our JSON Converter supports a wide range of input and output formats:</p>
    <ul>
      <li><strong>JSON to CSV:</strong> Convert JSON arrays to comma-separated values</li>
      <li><strong>JSON to XML:</strong> Transform JSON to standard XML format</li>
      <li><strong>JSON to YAML:</strong> Create human-readable YAML configuration</li>
      <li><strong>JSON to TypeScript:</strong> Generate TypeScript interfaces automatically</li>
      <li><strong>JSON to Go:</strong> Create Go struct definitions with JSON tags</li>
      <li><strong>JSON to Rust:</strong> Generate Rust structs with Serde annotations</li>
      <li><strong>JSON to Python:</strong> Create Python dataclasses</li>
      <li><strong>CSV to JSON:</strong> Convert CSV data to JSON</li>
      <li><strong>XML to JSON:</strong> Transform XML documents to JSON</li>
      <li><strong>YAML to JSON:</strong> Convert YAML to JSON</li>
    </ul>

    <h3>How to Use JSON Converter</h3>
    <ol>
      <li><strong>Select Input Format:</strong> Choose the format of your source data (JSON, XML, YAML, or CSV)</li>
      <li><strong>Paste Input Data:</strong> Enter your data in the left editor</li>
      <li><strong>Select Output Format:</strong> Choose the desired output format</li>
      <li><strong>Click Convert:</strong> The tool instantly transforms your data</li>
      <li><strong>Copy Result:</strong> Copy the converted output to clipboard</li>
    </ol>

    <h3>JSON to TypeScript</h3>
    <p>One of our most popular features is JSON to TypeScript conversion. This automatically generates TypeScript interfaces from your JSON data, providing type safety in TypeScript projects.</p>

    <h3>JSON to CSV</h3>
    <p>Converting JSON to CSV is essential when you need to work with spreadsheet applications or import data into databases. Our converter handles both flat JSON arrays and nested structures, flattening them appropriately for CSV format.</p>

    <h3>JSON to YAML</h3>
    <p>YAML is widely used for configuration files due to its readability. Our converter produces clean, properly indented YAML that's easy to maintain. This is particularly useful for Docker, Kubernetes, and CI/CD configurations.</p>

    <h3>Use Cases for JSON Converter</h3>
    <ul>
      <li><strong>API Integration:</strong> Convert API responses to different formats</li>
      <li><strong>Database Import:</strong> Prepare JSON data for database imports</li>
      <li><strong>Configuration:</strong> Generate config files in various formats</li>
      <li><strong>Code Generation:</strong> Create type definitions for programming languages</li>
      <li><strong>Data Migration:</strong> Transform data between different systems</li>
      <li><strong>Legacy System Integration:</strong> Convert JSON to XML for older systems</li>
    </ul>

    <h3>ISON Format - Save 70% Tokens</h3>
    <p>Looking for even more compression? Try our <a href="/formatter">JSON to ISON converter</a>. ISON (Interchange Simple Object Notation) is a compact format optimized for LLMs that can reduce token usage by up to 70%, making it perfect for AI and machine learning applications.</p>

    <h3>Related Tools</h3>
    <ul>
      <li><a href="/formatter">JSON Formatter</a> - Format JSON for readability</li>
      <li><a href="/validator">JSON Validator</a> - Validate JSON before conversion</li>
      <li><a href="/minify">JSON Minifier</a> - Compress JSON output</li>
      <li><a href="/compare">JSON Compare</a> - Compare converted results</li>
    </ul>

    <h3>SEO Keywords</h3>
    <p>json converter, json to csv, json to xml, json to yaml, json to typescript, convert json, json conversion tool, online json converter, free json converter, json to go, json to rust, json to python, csv to json, xml to json, yaml to json, json format converter, json transformer, json code generator, json to dataclass, json to interface.</p>

    <h3>Start Converting</h3>
    <p>Try our free JSON Converter now at <a href="/converter">tojsons.com/converter</a> and transform your data between formats instantly. With support for 10+ formats, it's the most comprehensive JSON converter available online!</p>
  </div>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "JSON Converter Online",
    "description": "Free online JSON converter - JSON to CSV, XML, YAML, TypeScript",
    "url": "https://tojsons.com/converter"
  }
  </script>
</BaseLayout>
