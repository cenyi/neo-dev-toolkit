---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import jaTranslations from '../../i18n/locales/ja.js';

const lang = 'ja-JP';
const t = jaTranslations;
---

<BaseLayout
  title="JSON バリデーターオンライン - JSON構文とスキーマの検証"
  lang={lang}
  description="無料のオンラインJSONバリデーター。JSON構文の検証、エラーチェック、JSON Schema検証をサポート。"
  keywords="JSON バリデーター, JSON 検証, JSON Schema バリデーター"
>
  <div slot="header">
    <LanguageSwitcher currentLocale="ja" />
  </div>
  <Sidebar slot="sidebar" t={t} />

  <div class="json-formatter-container">
    <div class="editor-workspace">
      <div class="input-area">
        <div class="input-section">
          <h1 class="section-label">JSON Validator</h1>
          <div class="input-editor-wrapper">
            <div id="monaco-editor-container" class="monaco-editor-container"></div>
          </div>
        </div>
        <div id="json-validation-error" class="validation-error"></div>
        <div class="output-controls">
          <button id="format-btn">Format JSON</button>
          <button id="compress-copy">{t.compressCopy}</button>
        </div>
      </div>
    </div>
  </div>

  <script type="module">
    window.MonacoEnvironment = {
      getWorkerUrl: function (workerId, label) {
        return `https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs/base/workers/${label === 'json' ? 'json.worker' : 'editor.worker'}.js`;
      }
    };
    import * as monaco from 'https://esm.sh/monaco-editor@0.45.0';
    let editor = null;
    document.addEventListener('DOMContentLoaded', () => {
      const container = document.getElementById('monaco-editor-container');
      if (!container) return;
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          if (container.offsetWidth === 0 || container.offsetHeight === 0) {
            setTimeout(() => createEditor(container), 50);
          } else {
            createEditor(container);
          }
        });
      });
    });
    function createEditor(container) {
      const savedFontSize = localStorage.getItem('editorFontSize') || '13';
      editor = monaco.editor.create(container, {
        value: '', language: 'json', theme: 'vs', automaticLayout: true,
        fontSize: parseInt(savedFontSize), minimap: { enabled: false },
        lineNumbers: 'on', tabSize: 2, padding: { top: 12, bottom: 12 }
      });
      monaco.editor.onDidChangeMarkers(() => {
        const errorElement = document.getElementById('json-validation-error');
        if (!errorElement || !editor) return;
        const model = editor.getModel();
        if (!model) return;
        const modelMarkers = model.getAllMarkers();
        if (modelMarkers.length === 0) {
          errorElement.className = 'validation-error valid';
          errorElement.innerHTML = '✓ Valid JSON';
        } else {
          const firstError = modelMarkers[0];
          errorElement.className = 'validation-error show';
          errorElement.textContent = `Line ${firstError.startLineNumber}: ${firstError.message}`;
        }
      });
    }
    document.getElementById('format-btn')?.addEventListener('click', () => {
      if (!editor) return;
      try {
        const parsed = JSON.parse(editor.getValue());
        editor.setValue(JSON.stringify(parsed, null, 2));
        showToast('JSON formatted!');
      } catch (e) {
        showToast('Invalid JSON: ' + e.message);
      }
    });
    function showToast(message) {
      const existing = document.querySelector('.toast-message');
      if (existing) existing.remove();
      const toast = document.createElement('div');
      toast.className = 'toast-message';
      toast.textContent = message;
      toast.style.cssText = 'position:fixed;bottom:20px;right:20px;background:#22c55e;color:white;padding:12px 20px;border-radius:6px;z-index:9999';
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 3000);
    }
  </script>

  <style>
    .json-formatter-container { max-width: 1800px; margin: 0 auto; padding: 8px; height: calc(100vh - var(--sidebar-height, 40px)); display: flex; flex-direction: column; }
    .editor-workspace { flex: 1; min-height: 0; }
    .input-area { flex: 1; display: flex; flex-direction: column; gap: 10px; }
    .input-section { flex: 1; display: flex; flex-direction: column; min-height: 0; }
    h1.section-label { font-size: 1rem; font-weight: 700; color: #0f172a; margin-bottom: 8px; }
    .input-editor-wrapper { display: flex; border: 1px solid #e1e4e8; border-radius: 8px; overflow: hidden; flex: 1; min-height: 0; }
    .monaco-editor-container { flex: 1; width: 100%; min-height: 300px; }
    .validation-error { padding: 12px 16px; border-radius: 6px; font-size: 0.875rem; margin-bottom: 10px; }
    .validation-error.show { background: #fee2e2; border: 1px solid #fca5a5; color: #991b1b; border-left: 4px solid #ef4444; }
    .validation-error.valid { background: #dcfce7; border: 1px solid #86efac; color: #166534; border-left: 4px solid #22c55e; }
    .output-controls { display: flex; gap: 6px; }
    .output-controls button { padding: 6px 12px; background: #3b82f6; color: white; border: none; border-radius: 5px; cursor: pointer; }
    .content-section { max-width: 900px; margin: 40px auto; padding: 0 20px; }
    .content-section h2 { font-size: 1.75rem; color: #0f172a; margin: 30px 0 15px; }
    .content-section h3 { font-size: 1.25rem; color: #1f2937; margin: 25px 0 12px; }
    .content-section p { color: #4b5563; line-height: 1.7; margin-bottom: 15px; }
  </style>

  <div class="content-section">
    <h2>JSON Validator Online</h2>
    <p>Welcome to our JSON Validator tool. Validate JSON syntax and schema instantly.</p>
  </div>
</BaseLayout>
