---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import koTranslations from '../../i18n/locales/ko.js';

const lang = 'ko-KR';
const t = koTranslations;
---

<BaseLayout
  title="JSON 민ifie 온라인 - JSON 압축"
  lang={lang}
  description="무료 온라인 JSON 민ifie. 공백을 제거하여 JSON 압축."
  keywords="JSON 민ifie, JSON 압축"
>
  <div slot="header">
    <LanguageSwitcher currentLocale="ko" />
  </div>
  <Sidebar slot="sidebar" t={t} />

  <div class="json-formatter-container">
    <div class="editor-workspace">
      <div class="input-area">
        <div class="input-section">
          <h1 class="section-label">JSON Minifier</h1>
          <div class="input-editor-wrapper">
            <div id="monaco-editor-container" class="monaco-editor-container"></div>
          </div>
        </div>
        <div class="output-controls">
          <button id="minify-btn">Minify JSON</button>
          <button id="format-btn">Format JSON</button>
        </div>
      </div>
    </div>
  </div>

  <script type="module">
    window.MonacoEnvironment = {
      getWorkerUrl: function (workerId, label) {
        return `https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs/base/workers/${label === 'json' ? 'json.worker' : 'editor.worker'}.js`;
      }
    };
    import * as monaco from 'https://esm.sh/monaco-editor@0.45.0';
    let editor = null;
    document.addEventListener('DOMContentLoaded', () => {
      const container = document.getElementById('monaco-editor-container');
      if (!container) return;
      editor = monaco.editor.create(container, { value: '', language: 'json', theme: 'vs', automaticLayout: true, fontSize: 13, minimap: { enabled: false }, lineNumbers: 'on', tabSize: 2, padding: { top: 12, bottom: 12 } });
    });
    document.getElementById('minify-btn')?.addEventListener('click', () => {
      if (!editor) return;
      try {
        const parsed = JSON.parse(editor.getValue());
        editor.setValue(JSON.stringify(parsed));
        showToast('JSON minified!');
      } catch (e) { showToast('Error: ' + e.message); }
    });
    function showToast(msg) {
      const toast = document.createElement('div');
      toast.className = 'toast-message';
      toast.textContent = msg;
      toast.style.cssText = 'position:fixed;bottom:20px;right:20px;background:#22c55e;color:white;padding:12px 20px;border-radius:6px;z-index:9999';
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 3000);
    }
  </script>

  <style>
    .json-formatter-container { max-width: 1800px; margin: 0 auto; padding: 8px; height: calc(100vh - var(--sidebar-height, 40px)); display: flex; flex-direction: column; }
    .editor-workspace { flex: 1; min-height: 0; }
    .input-area { flex: 1; display: flex; flex-direction: column; gap: 10px; }
    .input-section { flex: 1; display: flex; flex-direction: column; min-height: 0; }
    h1.section-label { font-size: 1rem; font-weight: 700; color: #0f172a; margin-bottom: 8px; }
    .input-editor-wrapper { display: flex; border: 1px solid #e1e4e8; border-radius: 8px; overflow: hidden; flex: 1; min-height: 0; }
    .monaco-editor-container { flex: 1; width: 100%; min-height: 300px; }
    .output-controls { display: flex; gap: 6px; }
    .output-controls button { padding: 8px 16px; background: #3b82f6; color: white; border: none; border-radius: 5px; cursor: pointer; }
  </style>

  <div class="content-section"><h2>JSON Minifier Online</h2><p>Compress JSON data.</p></div>
</BaseLayout>
